{
  "expo": {
    "name": "PetApp",
    "slug": "petapp",
    "scheme": "petapp",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.israeleom.petapp"
    },
    "android": {
      "package": "com.israeleom.petapp"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}
