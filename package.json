{
  "name": "petapp",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "setup": "npx expo install react react-native expo-router react-native-safe-area-context react-native-screens expo-linking expo-constants expo-status-bar expo-splash-screen expo-font expo-haptics react-native-svg @react-native-async-storage/async-storage @expo-google-fonts/fredoka @expo-google-fonts/nunito react-dom react-native-web && npm install zustand && npx expo install -- --save-dev typescript @types/react",
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor@latest"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
